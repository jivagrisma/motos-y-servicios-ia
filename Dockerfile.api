# API FastAPI — Cloud Run
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi "uvicorn[standard]" pandas google-genai python-dateutil httpx

COPY pipeline/ ./pipeline/
COPY api/ ./api/
COPY pipeline.py ddl.sql* ./
# BD y datasets ya procesados se hornean en la imagen (MVP: estado embebido)
COPY data/ ./data/
COPY datasets-assessment-analista-ia/ ./datasets-assessment-analista-ia/

ENV GCP_PROJECT=motos-servicios-assessment-ia GCP_LOCATION=us-central1
EXPOSE 8080
CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8080", "--app-dir", "/app"]
